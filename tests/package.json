{
  "name": "garnetsky-tests",
  "version": "1.0.0",
  "description": "Unit tests for GarnetSky application",
  "type": "module",
  "scripts": {
    "test:ui": "vitest run --config vitest.config.js",
    "test:ui:watch": "vitest --config vitest.config.js",
    "test:backend": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
    "test": "npm run test:backend && npm run test:ui"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "jest": "^29.7.0",
    "jsdom": "^24.0.0",
    "vitest": "^1.3.1"
  },
  "keywords": ["testing", "unit-tests"],
  "author": "GarnetSky Team"
}
